<?xml version="1.0" encoding="utf-8"?>
<!-- Resource-only app with a LocaleConfig and a default locale, so the instrumentation test can
     dump how Android picks each resource's language for it (#249). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config" />
</manifest>
