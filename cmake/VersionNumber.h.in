/* Generated by CMake from cmake/VersionNumber.h.in: the version is project() in CMakeLists.txt
 * and nowhere else (#13). C as well as C++, since hydroid_res.h includes it.
 *
 * These are the version of the headers being compiled. hydroid_res_version() and
 * hydroid::res::version() return the version of the library that was built, so with a shared
 * library a consumer can compare the two to see that it loaded one compatible with these
 * headers (README.md says when it is). */
#ifndef HYDROID_RES_VERSION_NUMBER_H
#define HYDROID_RES_VERSION_NUMBER_H

#define HYDROID_RES_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define HYDROID_RES_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define HYDROID_RES_VERSION_PATCH @PROJECT_VERSION_PATCH@

/* "major.minor.patch" */
#define HYDROID_RES_VERSION "@PROJECT_VERSION@"

#endif /* HYDROID_RES_VERSION_NUMBER_H */
